{
  "name": "dsh-peak-guard",
  "version": "0.2.0",
  "private": true,
  "description": "DeepSeek peak/off-peak (峰谷) cost guard: confirms model calls dispatched inside DeepSeek's peak windows, with a sidebar enable/disable switch",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./src/peak.js": "./src/peak.js",
    "./src/config.js": "./src/config.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "sync.mjs",
    "install.mjs",
    "lib/client.js",
    "src/peak.js",
    "src/config.js",
    "src/client.js",
    "scripts/build-client.mjs",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/dsh-peak-guard.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "deepseek",
    "cost-guard",
    "off-peak"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "build:client:check": "node scripts/build-client.mjs --check",
    "install:plugin": "node install.mjs",
    "sync": "node sync.mjs",
    "sync:check": "node sync.mjs --check",
    "uninstall:plugin": "node install.mjs --uninstall",
    "test": "node --test \"tests/*.test.js\""
  }
}
